# Whisper Performance & Hosting Tuning
WHISPER_MODEL=base.en           # Options: tiny.en (fastest), base.en (recommended), small.en
WHISPER_COMPUTE_TYPE=int8       # Options: int8 (low memory/fast CPU), float32
WHISPER_THREADS=4               # Number of CPU threads to allocate for inference

# Optional Ultra-Fast Cloud Fallback (Groq is ~250x realtime speed)
# GROQ_API_KEY=gsk_xxxx
# OPENAI_API_KEY=sk-proj-xxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxx

