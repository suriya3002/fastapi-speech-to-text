# Whisper Performance & Hosting Tuning (1 vCPU, 512MB-1GB RAM, <200MB Python RAM target)
WHISPER_MODEL=base.en           # Options: tiny.en (~40-75MB RAM), base.en (~140-180MB RAM)
WHISPER_COMPUTE_TYPE=int8       # Strictly int8 quantization for ultra-low memory & fast CPU GEMM
WHISPER_THREADS=1               # 1 or 2 threads to prevent CPU thrashing on shared 1 vCPU
OMP_NUM_THREADS=1               # Restrict OpenMP thread contention
CT2_USE_EXPERIMENTAL_PACKED_GEMM=1

# Application Limits
MAX_FILE_SIZE_MB=25             # Memory safe upload limit for 512MB RAM hosts
